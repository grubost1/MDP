<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
android:layout_width="match_parent"
android:layout_height="match_parent"
android:padding="16dp">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Предустановленная сложность:"
        android:textStyle="bold"
        android:textSize="18sp"
        android:layout_marginBottom="8dp"/>

    <RadioGroup
        android:id="@+id/rgDifficultyPreset"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="24dp">
        <RadioButton android:id="@+id/rbEasy" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Легкий (Медленно, мало жуков)" />
        <RadioButton android:id="@+id/rbMedium" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Средний (Стандарт)" />
        <RadioButton android:id="@+id/rbHard" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Сложный (Экстрим)" />
    </RadioGroup>

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Скорость жуков:"/>
    <SeekBar android:id="@+id/sbSpeed" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <TextView android:id="@+id/tvSpeedValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="12dp"/>

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Лимит насекомых на экране:"/>
    <SeekBar android:id="@+id/sbMaxCockroaches" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <TextView android:id="@+id/tvMaxCockroachesValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="12dp"/>

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Длительность раунда:"/>
    <SeekBar android:id="@+id/sbRoundDuration" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <TextView android:id="@+id/tvRoundDurationValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="12dp"/>

    <SeekBar android:id="@+id/sbBonusInterval" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
    <TextView android:id="@+id/tvBonusIntervalValue" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
</LinearLayout>
</ScrollView>
